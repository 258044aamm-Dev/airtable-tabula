{
	"name": "airtable-tabula",
	"version": "0.1.19",
	"description": "Local Airtable-like tables with selects, filters, query, CSV/Excel import, and optional Airtable sync",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"table",
		"database",
		"airtable",
		"tabula"
	],
	"license": "MIT",
	"author": "MehulG",
	"homepage": "https://github.com/MehulG/airtable-tabula",
	"repository": {
		"type": "git",
		"url": "https://github.com/MehulG/airtable-tabula.git"
	},
	"devDependencies": {
		"@types/node": "^20.11.0",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"esbuild": "^0.25.0",
		"obsidian": "^1.7.2",
		"tslib": "^2.8.1",
		"typescript": "^5.7.2"
	},
	"dependencies": {
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"read-excel-file": "^9.3.1"
	}
}
